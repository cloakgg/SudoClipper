<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SudoClipper</RootNamespace>
    <AssemblyName>sudoclipper</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sudoclipper</ToolCommandName>
    <PackageId>SUDOCLIPPER</PackageId>
    <Version>1.0.0</Version>
    <Authors>SUDOCLIPPER</Authors>
    <Description>SUDOCLIPPER - a fully local clipping tool. Paste a YouTube link, get viral 9:16 clips with burned-in captions.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>clips;shorts;youtube;ffmpeg;local</PackageTags>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>tools/net10.0/any/wwwroot/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="wwwroot/**" />
  </ItemGroup>

</Project>
