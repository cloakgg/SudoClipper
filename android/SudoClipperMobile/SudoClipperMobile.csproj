<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SudoClipperMobile</RootNamespace>
    <AssemblyName>SudoClipperMobile</AssemblyName>
    <ApplicationId>com.sudoclipper.mobile</ApplicationId>
    <ApplicationTitle>SUDOCLIPPER</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <StripDebugSymbols>true</StripDebugSymbols>
  </PropertyGroup>

</Project>
