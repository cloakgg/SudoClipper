#!/usr/bin/env bash
# Skill: Git status

# Check git status and show changes
# Usage: openfrog git-status

set -euo pipefail

if ! command -v git &>/dev/null; then
    echo "Git not installed"
    exit 1
fi

echo "=== Git Status ==="
git status
echo ""
echo "=== Recent Changes ==="
git diff --stat HEAD 2>/dev/null || echo "No commits yet"