select_model() {
    local model="${1:-}"
    if [[ -n "$model" ]]; then
        MODEL="$model"
        echo -e "\e[38;5;82mModel set to: $model\e[0m"
    else
        clear
        show_header
        echo -e "\e[38;5;82m=== Model Selector ===\e[0m"
        echo -e "\e[38;5;82mCurrent model: $MODEL\e[0m"
        echo ""
        echo -e "\e[38;5;82mPopular models (grouped by provider):\e[0m"
        echo -e "  \e[38;5;82mOpenAI:\e[0m   gpt-4o, gpt-4, gpt-3.5-turbo"
        echo -e "  \e[38;5;82mAnthropic:\e0m  claude-3-opus, claude-3-sonnet, claude-instant"
        echo -e "  \e[38;5;82mGoogle:\e[0m   gemini-1.5-flash, gemini-1.5-pro"
        echo -e "  \e[38;5;82mLocal:\e[0m    local-llama, local-mistral"
        echo -e ""
        echo -ne "\e[38;5;82mSelect model: \e[0m"
        read -r model
        MODEL="$model"
        echo -e "\e[38;5;82mModel updated to: $model\e[0m"
    fi
    save_config
}

select_quality() {
    local quality="${1:-}"
    case "$quality" in
        fast|Fast)
            QUALITY="fast"
            echo -e "\e[38;5;82mQuality set to Fast\e[0m"
            ;;
        balanced|Balanced)
            QUALITY="balanced"
            echo -e "\e[38;5;82mQuality set to Balanced\e[0m"
            ;;
        best|Best)
            QUALITY="best"
            echo -e "\e[38;5;82mQuality set to Best\e[0m"
            ;;
        *)
            echo -e "\e[38;5;196mInvalid quality mode. Use: Fast, Balanced, Best\e[0m"
            ;;
    esac
    save_config
}

