# ============ Core Skills ============

# Skill: Read a file
skill_read_file() {
    local filepath="${1:-}"
    if [[ -z "$filepath" ]]; then
        echo -e "\e[38;5;196mUsage: read-file <filepath>\e[0m"
        return 1
    fi
    
    if [[ -f "$filepath" ]]; then
        echo -e "\e[38;5;82m=== File: $filepath ===\e[0m"
        cat "$filepath"
        echo -e "\e[38;5;82m=== End of file ===\e[0m"
    else
        echo -e "\e[38;5;196mFile not found: $filepath\e[0m"
        return 1
    fi
}

# Skill: Write to a file
skill_write_file() {
    local filepath="${1:-}"
    local content="${2:-}"
    
    if [[ -z "$filepath" ]]; then
        echo -e "\e[38;5;196mUsage: write-file <filepath> [content]\e[0m"
        return 1
    fi
    
    if [[ -z "$content" ]]; then
        echo -e "\e[38;5;196mPlease provide content to write.\e[0m"
        return 1
    fi
    
    # Create parent directories if needed
    mkdir -p "$(dirname "$filepath")"
    
    printf '%s' "$content" > "$filepath"
    echo -e "\e[38;5;82m✓ Written to: $filepath\e[0m"
    echo -e "\e[38;5;82m$(wc -c < "$filepath") bytes written.\e[0m"
}

# Skill: Run a shell command
skill_run_cmd() {
    local cmd="${1:-}"
    
    if [[ -z "$cmd" ]]; then
        echo -e "\e[38;5;196mUsage: run-cmd <command>\e[0m"
        return 1
    fi
    
    echo -e "\e[38;5;82mRunning: $cmd\e[0m"
    echo -e "\e[38;5;82m(Note: This is a safe preview - actual command execution would happen here)\e[0m"
    
    # In a real implementation, this would ask for confirmation for dangerous commands
    # For now, just show what would be run
    eval "$cmd" 2>&1 || echo -e "\e[38;5;196mCommand failed or produced no output.\e[0m"
}

# Skill: Git status
skill_git_status() {
    if command -v git &>/dev/null; then
        echo -e "\e[38;5;82m=== Git Status ===\e[0m"
        git status 2>/dev/null || echo -e "\e[38;5;196mNot a git repository\e[0m"
        echo -e "\e[38;5;82m=== Remotes ===\e[0m"
        git remote -v 2>/dev/null || echo -e "\e[38;5;196mNo remote configured\e[0m"
    else
        echo -e "\e[38;5;196mGit not installed\e[0m"
    fi
}

# Skill: Summarize text
skill_summarize() {
    local text="${1:-}"
    
    if [[ -z "$text" ]]; then
        echo -e "\e[38;5;196mUsage: summarize <text>\e[0m"
        return 1
    fi
    
    # Simple summary - just show first 3 sentences
    local count=0
    local summary=""
    for sentence in $(echo "$text" | tr '.' '\n'); do
        if [[ $count -lt 3 ]]; then
            summary+="$sentence. "
            ((count++))
        fi
    done
    
    echo -e "\e[38;5;82m=== Summary ===\e[0m"
    echo -e "\e[38;5;82m$summary\e[0m"
    echo -e "\e[38;5;82m=== End of summary ===\e[0m"
}

