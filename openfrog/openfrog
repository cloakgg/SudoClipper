# Think indicator - shows frog thinking
think() {
    printf '\e[?25l'  # hide cursor
    printf '\e[38;5;82m[▲ thinking...]\e[0m\r'
    frog_thinking
    sleep 0.1
}

# Clear think indicator and show idle frog
clear_think() {
    printf '\e[2K\r'  # clear line
    frog_idle
    term_reset
}

# ============ Prompt & Input ============

# Prompt user for input with history support
prompt_input() {
    local default="${1:-}"
    
    show_header
    show_footer
    
    # Print prompt
    printf '\e[38;5;82mOpenFrog'
    [[ "$QUALITY" != "balanced" ]] && printf " [$QUALITY]"
    printf " ($MODEL) \$ \e[0m"
    
    # Read input with basic history (readline not available, use simple read)
    if [[ -n "$default" ]]; then
        read -r -e -i "$default" input
    else
        read -r -e input
    fi
    
    # Output the input text
    printf '%s\n' "$input"
    echo "$input"
}

# ============ Slash Commands ============

handle_command() {
    local cmd="$1"
    shift
    
    case "$cmd" in
        /help)
            show_help
            ;;
        /clear|/reset)
            clear
            ;;
        /exit)
            term_reset
            exit 0
            ;;
        /settings)
            show_settings
            ;;
        /model)
            select_model "$@"
            ;;
        /quality|/q)
            select_quality "$@"
            ;;
        /keys)
            manage_keys "$@"
            ;;
        /free)
            show_free_options
            ;;
        /skills|/skill)
            list_skills "$@"
            ;;
        /frog)
            change_frog_mood "$@"
            ;;
        /doctor)
            doctor_check
            ;;
        /version)
            echo "OpenFrog v0.1.0"
            ;;
        /init)
            init_project
            ;;
        /clearhistory)
            echo "History cleared"
            ;;
        /memory)
            show_memory
            ;;
        *)
            echo -e "\e[38;5;196mUnknown command: $cmd\e[0m"
            echo -e "\e[38;5;82mType /help for available commands.\e[0m"
            ;;
    esac
}

