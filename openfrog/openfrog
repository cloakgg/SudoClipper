# ============ Main Loop ============

# Process a user request
process_request() {
    local input="${1:-}"
    
    if [[ -z "$input" ]]; then
        return
    fi
    
    # Check for slash commands
    if [[ "$input" == /* ]]; then
        handle_command "${input#/}"
        return
    fi
    
    # Think indicator
    think
    
    # Process as a natural language request
    case "$input" in
        *hello*|*hi*|*hey*)
            echo -e "\e[38;5;82mHello! I'm OpenFrog, your friendly frog-powered AI agent.\e[0m"
            echo -e "\e[38;5;82mType /help for available commands.\e[0m"
            change_frog_mood working
            ;;
        *read*|*file*)
            # Try to interpret as a file read request
            local file=""
            for word in $input; do
                if [[ -f "$word" ]]; then
                    file="$word"
                    break
                fi
            done
            if [[ -n "$file" ]]; then
                skill_read_file "$file"
            else
                echo -e "\e[38;5;82mI can read files for you. Usage: read-file <filepath>\e[0m"
            fi
            ;;
        *write*|*create*)
            local file=""
            local content=""
            for word in $input; do
                if [[ -f "$word" ]] || [[ "$word" == /* ]]; then
                    file="$word"
                fi
            done
            if [[ -n "$file" ]]; then
                # Get content after the file path
                local content="${input#*$file}"
                content="${content# }"
                skill_write_file "$file" "$content"
            else
                echo -e "\e[38;5;82mI can write to files. Usage: write-file <filepath> [content]\e[0m"
            fi
            ;;
        *git*|*status*)
            skill_git_status
            ;;
        *summarize*|*summary*)
            local text=""
            for word in $input; do
                text+="$word "
            done
            skill_summarize "$text"
            ;;
        *search*|*web*)
            local query=""
            for word in $input; do
                query+="$word "
            done
            skill_web_search "${query% }"
            ;;
        *)
            # General request - show placeholder response
            echo -e "\e[38;5;82mOpenFrog received your request: \"$input\"\e[0m"
            echo -e "\e[38;5;82m(This is a demo mode. Configure an API key or use /free for free options.)\e[0m"
            echo -e "\e[38;5;82mType /help for available commands.\e[0m"
            ;;
    esac
    
    clear_think
    change_frog_mood idle
}

# Main entry point
main() {
    # Set up traps for clean exit
    trap term_reset EXIT
    trap term_hide WINCH
    
    # Initial frog mood
    change_frog_mood idle
    
    # Load config
    load_config
    
    # Display initial header
    show_header
    show_footer
    
    # Main interaction loop
    while true; do
        # Prompt for input
        local input
        input=$(prompt_input)
        
        # Skip empty input
        [[ -z "$input" ]] && continue
        
        # Process the input
        process_request "$input"
    done
}

# Run main function
main