#!/usr/bin/env bash
# OpenFrog - A free and open-source AI agent for Windows and Linux

set -euo pipefail

# Theme colors - Green and Black
FG="#D0F0D0"      # light green text
BG="#0A0F0A"      # near-black background
ACCENT="#39D353"  # frog green
WARNING="#FFA500" # amber
ERROR="#FF5555"   # soft red
PRIMARY_GREEN="#2ECC40"

# State
MODEL="auto"
QUALITY="balanced"
PROVIDER=""
API_KEY=""
SESSION_FILE=".openfrog_session"
CONFIG_FILE=".openfrogrc"

# Skill categories
SKILL_READ="read-file"
SKILL_WRITE="write-file"
SKILL_EDIT="edit-code"
SKILL_RUN="run-cmd"
SKILL_GIT="git-status"
SKILL_SUMM="summarize"
SKILL_WEB="web-search"

# Load config if exists
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
    fi
}

save_config() {
    cat > "$CONFIG_FILE" <<EOF
MODEL="$MODEL"
QUALITY="$QUALITY"
PROVIDER="$PROVIDER"
API_KEY="$API_KEY"
EOF
}

load_config

# ============ Frog Mascot Functions ============

# Reset terminal cursor
term_reset() {
    printf '\e[0m\e[?25h'
}

term_hide() {
    printf '\e[?25l'
}

# Frog mascot states - SVG-like ASCII art
frog_idle() {
    printf '\e[38;5;82m╭───╮\e[0m\n'
    printf '\e[38;5;82m│ █ █ │\e[0m\n'
    printf '\e[38;5;82m╰───╯\e[0m\n'
}

frog_thinking() {
